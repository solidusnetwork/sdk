{
  "name": "@solidus/sdk",
  "version": "0.1.0",
  "description": "Solidus Network SDK — DID resolution, verifiable credential issuance and verification, and on-chain queries via JSON-RPC.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && mkdir -p dist/stub/migrations && cp src/stub/migrations/*.sql dist/stub/migrations/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@noble/ed25519": "^2.1.0",
    "@noble/hashes": "^1.5.0",
    "@solidus/auth": "workspace:*",
    "@solidus/types": "workspace:*",
    "bs58": "^6.0.0",
    "postgres": "^3.4.4"
  },
  "devDependencies": {
    "@solidus/config": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "keywords": [
    "solidus",
    "did",
    "verifiable-credentials",
    "vc",
    "blockchain",
    "decentralized-identity",
    "sdk"
  ],
  "author": "Solidus Network (https://solidus.network)",
  "license": "Apache-2.0",
  "homepage": "https://solidus.network",
  "bugs": {
    "url": "https://github.com/solidusnetwork/sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/solidusnetwork/sdk.git",
    "directory": "sdk"
  },
  "publishConfig": {
    "access": "public"
  }
}
